.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #e8ebf2;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 99;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0 8rpx;
  color: #9aa3b5;
}

.tab.active {
  color: #2f6bff;
}

.icon {
  width: 44rpx;
  height: 44rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.icon-edit {
  background-image: url("data:image/svg+xml;base64,");
}

.tab.active .icon-edit {
  background-image: url("data:image/svg+xml;base64,");
}

.icon-mine {
  background-image: url("data:image/svg+xml;base64,");
}

.tab.active .icon-mine {
  background-image: url("data:image/svg+xml;base64,");
}

.icon-chart {
  background-image: url("data:image/svg+xml;base64,");
}

.tab.active .icon-chart {
  background-image: url("data:image/svg+xml;base64,");
}

.tab-text {
  font-size: 22rpx;
  margin-top: 4rpx;
}
