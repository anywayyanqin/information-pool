.page {
  min-height: 100vh;
  background: #f2f3f7;
  padding-bottom: 40rpx;
}

.header {
  background: linear-gradient(135deg, #122a63 0%, #1d47b0 55%, #2f6bff 100%);
  padding: 0 28rpx 40rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  color: #ffffff;
  font-size: 48rpx;
}

.nav-back--ghost {
  visibility: hidden;
}

.nav-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
}

.header-sub {
  margin-top: 8rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.65);
  font-size: 24rpx;
}

.card {
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2430;
  margin-bottom: 20rpx;
}

.card-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: #9aa3b5;
  margin-left: 12rpx;
}

.sum-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.sum-reporter {
  font-size: 24rpx;
  color: #6b7690;
}

.sum-time {
  font-size: 22rpx;
  color: #b3bacb;
}

.sum-content {
  font-size: 28rpx;
  color: #2b3346;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.picked-tags {
  display: flex;
  flex-wrap: wrap;
}

.picked-tag {
  display: flex;
  align-items: center;
  background: #2b3556;
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  margin: 0 16rpx 16rpx 0;
}

.picked-x {
  margin-left: 10rpx;
  color: #9db4e8;
  font-size: 28rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.cell {
  position: relative;
  width: 31.5%;
  margin-bottom: 16rpx;
  padding: 28rpx 8rpx;
  background: #f2f4f8;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  text-align: center;
}

.cell--on {
  background: #eef3ff;
  border-color: #2f6bff;
}

.cell-name {
  font-size: 24rpx;
  color: #2b3346;
}

.cell--on .cell-name {
  color: #2f6bff;
  font-weight: 600;
}

.cell-badge--new {
  position: absolute;
  top: -12rpx;
  left: 16rpx;
  background: #f0524d;
  color: #ffffff;
  font-size: 18rpx;
  border-radius: 8rpx 8rpx 8rpx 0;
  padding: 2rpx 10rpx;
}

.cell-hot {
  position: absolute;
  top: -16rpx;
  right: 12rpx;
  font-size: 28rpx;
}

.assignees {
  display: flex;
  flex-wrap: wrap;
}

.assignee {
  display: flex;
  align-items: center;
  background: #f7f8fb;
  border-radius: 999rpx;
  padding: 8rpx 20rpx 8rpx 8rpx;
  margin: 0 16rpx 16rpx 0;
}

.avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.assignee-name {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #2b3346;
}

.page-pad {
  height: 160rpx;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -2rpx 12rpx rgba(35, 44, 78, 0.06);
}

.submit-btn {
  height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #4d8dff, #3b5bff);
  color: #ffffff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 60;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 61;
  display: flex;
  flex-direction: column;
  max-height: 72vh;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 28rpx 0 20rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2430;
}

.sheet-close {
  position: absolute;
  right: 32rpx;
  top: 20rpx;
  font-size: 44rpx;
  color: #9aa3b5;
}

.sheet-body {
  display: flex;
  min-height: 480rpx;
  max-height: 46vh;
}

.sheet-subs {
  width: 36%;
  background: #f7f8fb;
}

.sub-item {
  padding: 28rpx 24rpx;
  font-size: 26rpx;
  color: #454b5a;
}

.sub-item--on {
  background: #ffffff;
  color: #2f6bff;
  font-weight: 600;
}

.sheet-detail {
  flex: 1;
  padding: 24rpx 28rpx;
}

.detail-title {
  font-size: 26rpx;
  color: #9aa3b5;
  margin-bottom: 12rpx;
}

.detail-desc {
  font-size: 28rpx;
  color: #1f2430;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.staff-list {
  display: flex;
  flex-wrap: wrap;
}

.staff {
  display: flex;
  align-items: center;
  border: 2rpx solid #e3e8f2;
  border-radius: 999rpx;
  padding: 8rpx 20rpx 8rpx 8rpx;
  margin: 0 16rpx 16rpx 0;
  position: relative;
}

.staff--on {
  border-color: #2f6bff;
  background: #eef3ff;
}

.staff-name {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #2b3346;
}

.staff-check {
  width: 28rpx;
  margin-left: 8rpx;
  color: #2f6bff;
  font-size: 26rpx;
}

.sheet-btn {
  margin: 20rpx 24rpx;
  margin-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  margin-bottom: calc(20rpx + env(safe-area-inset-bottom));
  height: 84rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #4d8dff, #3b5bff);
  color: #ffffff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
