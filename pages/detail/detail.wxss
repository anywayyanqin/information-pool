.head-card {
  display: flex;
  align-items: center;
}

.seq {
  font-size: 26rpx;
  font-weight: 700;
  color: #2f6bff;
  margin-right: 16rpx;
}

.badge {
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  margin-right: 20rpx;
}

.badge-submitted {
  background: #e6f7ee;
  color: #1faa5c;
}

.badge-draft {
  background: #fff4e5;
  color: #f08c1a;
}

.meta {
  font-size: 26rpx;
  color: #2b3346;
  margin-right: 20rpx;
}

.dim {
  color: #b3bacb;
}

.g-title {
  font-size: 26rpx;
  color: #9aa3b5;
  margin-bottom: 16rpx;
}

.g-tags {
  display: flex;
  flex-wrap: wrap;
}

.g-tag {
  font-size: 26rpx;
  color: #2f6bff;
  background: #e9efff;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  margin: 0 16rpx 16rpx 0;
}

.content {
  font-size: 28rpx;
  color: #2b3346;
  line-height: 1.7;
  white-space: pre-wrap;
}

.att-grid {
  display: flex;
  flex-wrap: wrap;
}

.att-item {
  width: 180rpx;
  height: 180rpx;
  margin: 0 20rpx 20rpx 0;
}

.att-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
}

.att-file {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #f2f4f8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  box-sizing: border-box;
}

.att-file-ext {
  background: #2b3556;
  color: #ffffff;
  font-size: 20rpx;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.att-file-name {
  font-size: 22rpx;
  color: #4a5568;
  margin-top: 12rpx;
  max-width: 156rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.att-file-size {
  font-size: 20rpx;
  color: #b3bacb;
  margin-top: 4rpx;
}

.customer-btn {
  margin: 24rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: #f0f5ff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #2f6bff;
  font-size: 28rpx;
  font-weight: 500;
}

.customer-btn-arrow {
  font-size: 36rpx;
}

.route-foot {
  font-size: 22rpx;
  color: #9aa3b5;
  margin-top: 4rpx;
}

.pool-tag-main {
  background: #2b3556;
  color: #ffffff;
}

.reply-list {
  margin-top: 16rpx;
}

.reply-item {
  padding: 16rpx;
  background: #f7f8fb;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.reply-meta {
  font-size: 22rpx;
  color: #9aa3b5;
  margin-bottom: 8rpx;
}

.reply-content {
  font-size: 26rpx;
  color: #2b3346;
  line-height: 1.6;
}

.page-pad {
  height: 60rpx;
}
