<view class="header" style="padding-top: {{statusBarHeight}}px;">
  <view class="header-title">管理端</view>
  <view class="header-sub">{{poolFilter === 'main' ? '人工流转' : poolFilter === 'all' ? '全部信息' : poolFilter}} · 共 {{records.length}} 条</view>
  <view class="header-deco"></view>
</view>

<scroll-view scroll-x class="pool-filter" enhanced show-scrollbar="{{false}}">
  <view class="pool-chip {{poolFilter === item.name ? 'pool-chip-on' : ''}}" wx:for="{{executives}}" wx:key="name" data-key="{{item.name}}" bindtap="onSetPoolFilter">{{item.name}}</view>
  <view class="pool-chip {{poolFilter === 'main' ? 'pool-chip-on' : ''}}" data-key="main" bindtap="onSetPoolFilter">人工流转</view>
  <view class="pool-chip {{poolFilter === 'all' ? 'pool-chip-on' : ''}}" data-key="all" bindtap="onSetPoolFilter">全部</view>
</scroll-view>

<view class="empty" wx:if="{{!records.length}}">
  <view class="empty-title">暂无信息</view>
  <view class="empty-sub">切换上方池子查看其他信息</view>
</view>

<view class="rec" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
  <view class="rec-top">
    <view class="rec-top-left">
      <text class="rec-seq">#{{item.seq || '—'}}</text>
      <text class="rec-reporter">{{item.reporter.dept}}｜{{item.reporter.name}}</text>
      <text class="pool-badge pool-badge-{{item.poolStatus}}">{{item.poolStatusText}}</text>
    </view>
    <text class="rec-time">{{item.timeText}}</text>
  </view>
  <view class="rec-tags" wx:if="{{item.sources.length}}">
    <text class="rec-tag" wx:for="{{item.sources}}" wx:for-item="s" wx:key="*this">{{s}}</text>
  </view>
  <view class="rec-content">{{item.content || '（无文字描述）'}}</view>
  <view class="rec-foot" wx:if="{{item.attCount || item.sourceOther || item.customerName}}">
    <text wx:if="{{item.customerName}}">客户：{{item.customerName}}</text>
    <text wx:if="{{item.sourceOther}}">其他来源：{{item.sourceOther}}</text>
    <text wx:if="{{item.attCount}}">附件 {{item.attCount}} 个</text>
  </view>
  <view class="pool-tags">
    <text
      class="pool-tag {{p.isMain ? 'pool-tag-main' : 'pool-tag-sub'}} {{p.replied ? 'pool-tag-replied' : ''}}"
      wx:for="{{item.poolView}}"
      wx:for-item="p"
      wx:key="key"
    >{{p.name}}</text>
  </view>
</view>

<view class="page-pad"></view>
