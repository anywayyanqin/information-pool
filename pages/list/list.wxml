<view class="header" style="padding-top: {{statusBarHeight}}px;">
  <view class="header-title">我的填报</view>
  <view class="header-sub">{{user.dept}}｜{{user.name}}</view>
  <view class="header-deco"></view>
</view>

<view class="filters">
  <view class="filter {{filter === 'all' ? 'on' : ''}}" data-f="all" bindtap="onFilter">全部</view>
  <view class="filter {{filter === 'submitted' ? 'on' : ''}}" data-f="submitted" bindtap="onFilter">已提交</view>
  <view class="filter {{filter === 'draft' ? 'on' : ''}}" data-f="draft" bindtap="onFilter">草稿</view>
</view>

<view class="empty" wx:if="{{!records.length}}">
  <view class="empty-title">暂无记录</view>
  <view class="empty-sub">去「信息填报」提交第一条信息吧</view>
</view>

<view class="rec" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" data-status="{{item.status}}" bindtap="onOpen">
  <view class="rec-top">
    <view class="rec-top-left">
      <text class="rec-seq">#{{item.seq || '—'}}</text>
      <view class="badge badge-{{item.status}}">{{item.status === 'draft' ? '草稿' : '已提交'}}</view>
    </view>
    <text class="rec-time">{{item.timeText}}</text>
  </view>
  <view class="rec-tags" wx:if="{{item.sources.length}}">
    <text class="rec-tag" wx:for="{{item.sources}}" wx:for-item="s" wx:key="*this">{{s}}</text>
  </view>
  <view class="rec-content">{{item.content || '（无文字描述，点击查看附件）'}}</view>
  <view class="rec-foot" wx:if="{{item.footText}}">{{item.footText}}</view>
  <view class="pool-tags" wx:if="{{item.pools && item.pools.length}}">
    <text
      class="pool-tag {{p === 'main' ? 'pool-tag-main' : 'pool-tag-sub'}} {{item.replies && item.replies[p] ? 'pool-tag-replied' : ''}}"
      wx:for="{{item.pools}}"
      wx:for-item="p"
      wx:key="*this"
    >{{p === 'main' ? '人工流转' : p}}</text>
  </view>
</view>

<view class="page-pad"></view>
