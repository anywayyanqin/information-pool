.page {
  min-height: 100vh;
  background: #f2f3f7;
  padding-bottom: 40rpx;
}

.header {
  background: linear-gradient(135deg, #122a63 0%, #1d47b0 55%, #2f6bff 100%);
  padding: 0 28rpx 96rpx;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 48rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  color: #ffffff;
  font-size: 48rpx;
}

.nav-back--ghost {
  visibility: hidden;
}

.nav-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
}

.head {
  margin-top: 24rpx;
}

.head-name {
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
}

.head-account {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 26rpx;
}

.head-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.head-tag {
  margin: 0 12rpx 12rpx 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 22rpx;
}

.card {
  margin: -64rpx 24rpx 0;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
}

.card ~ .card {
  margin-top: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2430;
  margin-bottom: 20rpx;
}

.card-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: #9aa3b5;
}

.kv {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}

.kv + .kv {
  border-top: 1rpx solid #f2f3f7;
}

.kv-label {
  color: #9aa3b5;
  font-size: 26rpx;
}

.kv-value {
  color: #1f2430;
  font-size: 26rpx;
  font-weight: 500;
}

.kv-value--accent {
  color: #e6432d;
}

.pos {
  margin-top: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f2f3f7;
}

.pos-title {
  color: #9aa3b5;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.pos-chips {
  display: flex;
  flex-wrap: wrap;
}

.pos-chip {
  margin: 0 12rpx 12rpx 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f0f5ff;
  color: #2f6bff;
  font-size: 24rpx;
}

.svc-summary {
  color: #2f6bff;
  font-size: 26rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.svc-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}

.svc-row + .svc-row {
  border-top: 1rpx solid #f2f3f7;
}

.svc-dept {
  color: #1f2430;
  font-size: 26rpx;
}

.svc-count {
  color: #9aa3b5;
  font-size: 24rpx;
}

.tl-item {
  position: relative;
  padding-left: 36rpx;
  padding-bottom: 28rpx;
}

.tl-item:last-child {
  padding-bottom: 0;
}

.tl-dot {
  position: absolute;
  left: 0;
  top: 10rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #2f6bff;
}

.tl-line {
  position: absolute;
  left: 7rpx;
  top: 32rpx;
  bottom: 0;
  width: 2rpx;
  background: #e3e8f2;
}

.tl-head {
  display: flex;
  align-items: center;
}

.tl-date {
  color: #1f2430;
  font-size: 26rpx;
  font-weight: 600;
}

.tl-type {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #f0f5ff;
  color: #2f6bff;
  font-size: 22rpx;
}

.tl-owner {
  margin-top: 8rpx;
  color: #9aa3b5;
  font-size: 24rpx;
}

.tl-target {
  margin-top: 6rpx;
  color: #9aa3b5;
  font-size: 24rpx;
}

.tl-desc {
  margin-top: 8rpx;
  color: #454b5a;
  font-size: 26rpx;
  line-height: 1.6;
}

.rp {
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f7f8fb;
}

.rp + .rp {
  margin-top: 16rpx;
}

.rp-content {
  color: #1f2430;
  font-size: 26rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.rp-meta {
  margin-top: 10rpx;
  color: #9aa3b5;
  font-size: 22rpx;
}

.page-pad {
  height: 40rpx;
}
